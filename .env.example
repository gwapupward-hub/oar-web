# Server-only. Never prefix these with NEXT_PUBLIC_.
# Dedicated devnet RPC (may contain a provider key). Unset: the public devnet endpoint, for development only.
OAR_DEVNET_RPC_URL=
# Comma-separated SAS credential addresses whose OAR attestations are trusted. Empty by default, per the OAR spec.
OAR_TRUSTED_ISSUERS=
