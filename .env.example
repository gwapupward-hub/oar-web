# Server-only. Never prefix these with NEXT_PUBLIC_.
# Dedicated devnet RPC (may contain a provider key). Unset: the public devnet endpoint, for development only.
OAR_DEVNET_RPC_URL=
# Comma-separated SAS credential addresses whose OAR attestations are trusted. Empty by default, per the OAR spec.
OAR_TRUSTED_ISSUERS=

# Optional OAR GitHub App guided proof PR publishing. Keep server-only; never use NEXT_PUBLIC_.
# Required together to activate /api/github/connect; no live GitHub integration while unset.
OAR_GITHUB_CLIENT_ID=
OAR_GITHUB_CLIENT_SECRET=
OAR_GITHUB_APP_SLUG=
# Generate 32 random bytes as standard base64 in an owner-controlled environment. Never commit its value.
OAR_GITHUB_SESSION_KEY=
OAR_GITHUB_ORIGIN=https://oarprotocol.xyz
